# Duelyst + Hull Rupture: one dataset with a shared 64-color palette, same 6 classes as data_duelyst.
# raw/hullrupture is exported from the local game install with tools/export_unity_anims.py.
# The palette differs from data_duelyst, so checkpoints from that dataset don't carry over.
#     ./psg run pipelines/duelyst_hr.pipe

set DATA data_duelyst_hr
set UNITS raw/duelyst/public/duelyst-1.97.12/app/resources/units

stage build
  cmd sh tools/build.sh train_gpu sample

stage prepare
  cmd .venv/bin/python tools/prepare_animations.py --atlases ${UNITS} --frames raw/hullrupture --classes attack,breathing,death,hit,idle,run --out ${DATA}
  skip_if ${DATA}/meta.txt

stage train_large
  cmd ./train_gpu --data ${DATA} --out checkpoints/duelyst_hr_large --steps 20000 --dim 128 --layers 4 --lr 6e-4 --warmup 500

stage sample_large
  cmd ./sample --ckpt checkpoints/duelyst_hr_large --data ${DATA} --class idle --n 4 --frames 10 --out out/duelyst_hr_large/samples.bin
  cmd .venv/bin/python tools/render.py --samples out/duelyst_hr_large/samples.bin --palette ${DATA}/palette.txt --out out/duelyst_hr_large
